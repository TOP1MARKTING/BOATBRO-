# BoatPro static site (Apache / cPanel)
# Scope: document root only. Does NOT modify www.lunayairmarina.com/ — that subdirectory
# is served as its own site when requested directly.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave the separate marina website directory untouched.
  RewriteRule ^www\.lunayairmarina\.com(/.*)?$ - [L]

  # Serve real files and directories (prerendered HTML, assets, media, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Client-side fallback for routes not prerendered at build time (e.g. new blog posts).
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
