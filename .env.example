# BoatPro — client-side (Vite) variables only. Never commit real secrets.

# Site
VITE_SITE_URL=https://boatpro.club

# Firebase Web SDK (public — protect with Firestore/Storage rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional marketing links
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_GUESTS_LOGIN_URL=
VITE_MARINAS_LOGIN_URL=
VITE_ADMIN_EMAILS=

# Firebase Cloud Function URL for super-admin staff password reset (HTTPS only)
# Deploy: cd functions && npm install && npm run deploy
# Example: https://us-central1-boatpro1-18c6d.cloudfunctions.net/setUserPassword
VITE_ADMIN_PASSWORD_API_URL=
