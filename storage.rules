rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'admin@boatpro.club'
        || request.auth.token.email.lower() == 'info@boatpro.club'
      );
    }

    match /covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
