rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isHardcodedAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'admin@boatpro.club'
        || request.auth.token.email.lower() == 'info@boatpro.club'
      );
    }

    function isAdmin() {
      return isHardcodedAdmin()
        || (
          request.auth != null
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    match /covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /gallery/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
